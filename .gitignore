# Padrón nominal con datos personales (nombre + CUIL).
# NUNCA debe volver al repositorio ni al deploy: es información de terceros.
padron.js
padron*.js

# Recibos de sueldo (propios y de colegas): son datos personales, no van al
# repositorio ni al deploy. Se sacaron del control de versiones con
# `git rm -r --cached docs/Recibos`; los archivos siguen en disco.
docs/Recibos/

# Restos de un intento de instalar dependencias de Python (el sandbox los
# dejo con permisos raros). Se pueden borrar a mano sin problema.
.pip-tmp/
.pip-cache/
.pydeps/
.tmp-pip/

# Assets que se bajan solos para generar las placas de Instagram (tipografías
# y la librería qrcode). No se versionan: los recupera
# tools/preparar-assets-placas.py y pesan 2 MB.
tools/placas/fuentes/
tools/placas/deps/
__pycache__/
