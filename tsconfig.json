{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "target": "ES2020",
    "module": "ESNext",          // 👈 en lugar de NodeNext
    "moduleResolution": "Bundler", // 👈 mejor para proyectos web
    "types": [],
    
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  // El build compila SOLO src/. Los tests viven en tests/ y no deben
  // terminar dentro de dist/ (romperian el build de Vercel).
  "include": ["src/**/*.ts"]
}